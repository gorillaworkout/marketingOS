DATABASE_URL
OPENAI_BASE_URL
OPENAI_API_KEY
OPENROUTER_API_KEY
AI_MODEL

# GorillaWorkout OpenAI-compatible gateway (chat + images).
# Unset GORILLAWORKOUT_API_BASE falls back to https://llmdupoin.gorillaworkout.id/v1
# (not llm.gorillaworkout.id). Override per environment; never commit the API key.
GORILLAWORKOUT_API_BASE=https://llmdupoin.gorillaworkout.id/v1
GORILLAWORKOUT_API_KEY=

JWT_SECRET
FAL_KEY

# Preferred open-web search for AI Research, Event Plan pricing, Social Post, Article Market News, Video Script, and Market Research (Serper free tier). Used first when set.
# Article Market News also reads result pages directly, then via Jina Reader (r.jina.ai) when the direct read is blocked.
# Without this key, Article Market News still uses the publisher RSS feeds and public HTML search when those feeds are thin.
# Video Script reads reference links with Jina and searches the open web for topic, format, and competitors.
# Unit tests mock fetch and do not need this key. A live Generate does.
# Market Research live check (this agent VM has no .env, so do not expect a live Serper call here):
# 1. Set SERPER_API_KEY and JWT_SECRET, then open Market Research.
# 2. Brief a theme outside the fixed RSS list, for example semiconductor export controls.
# 3. Progress should say it is searching the open web and reading source pages.
# 4. When several candidates appear, deselect one and continue. The briefing uses only the kept rows.
# 5. A figure present in a read page can pass; an unsourced figure still fails the evidence repair loop (max 3).
# 6. History restore and DOCX download still work after the review checkbox.
# Jina Reader (https://r.jina.ai/) is used when a direct page read is blocked. No separate Jina key.
# Free accounts reject double-quoted query patterns (HTTP 400); person probes stay unquoted.
# If missing or exhausted, gather falls back to Wikipedia (id+en), Wikidata,
# Instant Answer, official seeds, Google News RSS, and Jina Reader. Brave is not required.
SERPER_API_KEY=

# Daily Dupoin AI Research topic watches. The VPS cron command is:
# npm run research:watches
# HTTP alternative: POST /api/ai-research/watches/run
# with header x-research-watch-secret set to this value.
AI_RESEARCH_WATCH_CRON_SECRET=

# HMAC secret for read-only AI Research share links (/share/ai-research/:token).
# Falls back to JWT_SECRET when unset. Tokens expire after 30 days.
AI_RESEARCH_SHARE_SECRET=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
